---
interface Props {
  /** Section / page title */
  title: string;
  /** Small muted label on the right (e.g. an item count) */
  meta?: string;
  /** When set, `meta` becomes the link through to the full collection */
  href?: string;
  /** Tag for the heading element */
  as?: "h1" | "h2";
}

const { title, meta, href, as: Tag = "h2" } = Astro.props as Props;
const sizeClass = Tag === "h1" ? "text-4xl md:text-5xl" : "text-3xl md:text-4xl";
---

<div class="flex items-end justify-between gap-4">
  <Tag class={`font-bold tracking-tight ${sizeClass}`}>{title}</Tag>

  {
    meta &&
      (href ? (
        <a
          href={href}
          class="group focus-visible:ring-offset-background shrink-0 rounded-sm pb-1.5 text-sm text-white/60 transition-colors hover:text-white focus-visible:ring-2 focus-visible:ring-cyan-400/70 focus-visible:ring-offset-4 focus-visible:outline-none"
        >
          {meta}
          {/* Decoration — the label already says where this goes. */}
          <span class="inline-block transition-transform group-hover:translate-x-0.5" aria-hidden="true">
            &#8594;
          </span>
        </a>
      ) : (
        <span class="shrink-0 pb-1.5 text-sm text-white/40">{meta}</span>
      ))
  }
</div>
