---
import SectionHeader from "@/components/section-header.astro";
import MediaCard from "@/components/media-card.astro";
import { movieCredit } from "@/lib/utils";

interface Props {
  title: string;
  href: string;
  /** Right-hand link label, e.g. "All 172 albums" */
  meta: string;
  posts: any[];
  type: "music" | "movies" | "anime" | "books";
}

const { title, href, meta, posts, type } = Astro.props;

// Every collection spells its cover art, title and byline differently, so each
// one gets a reader. Everything past this point is the same card.
const READERS = {
  music: (d: any) => ({ img: d.cover_art_url, title: d.album, subtitle: d.artist, by: "by" }),
  movies: (d: any) => ({ img: d.cover_art_url, title: d.title, subtitle: movieCredit(d), by: "directed by" }),
  anime: (d: any) => ({ img: d.art, title: d.title, subtitle: d.studio, by: "by" }),
  books: (d: any) => ({ img: d.cover_image, title: d.title, subtitle: d.author, by: "by" }),
} as const;

const read = READERS[type];
const shape = type === "music" ? "square" : "poster";
---

<section class="space-y-4">
  <SectionHeader title={title} href={href} meta={meta} />

  <div class="grid grid-cols-3 gap-2 sm:grid-cols-4 md:grid-cols-6 md:gap-3">
    {
      posts.map((post: any) => {
        const item = read(post.data);
        return (
          <MediaCard
            href={`/${type}/${post.id}`}
            imgSrc={item.img}
            imgAlt={item.title}
            title={item.title}
            subtitle={item.subtitle}
            shape={shape}
            ariaLabel={item.subtitle ? `${item.title} ${item.by} ${item.subtitle}` : item.title}
          />
        );
      })
    }
  </div>
</section>
